# llm-cost-governor 环境变量示例
# 所有变量都以 CG_ 为前缀（pydantic-settings 的 env_prefix）。
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略。

# ---------- Redis ----------
CG_REDIS_URL=redis://127.0.0.1:6379/0
# 业务 key 的统一前缀，便于多环境共用同一个 Redis 实例
CG_KEY_PREFIX=llm

# ---------- TTL（秒）----------
# 计量数据按天分桶，分桶 key 的 TTL 需要大于窗口报表的回溯天数 + 一个安全边界
CG_TTL_SECONDS=172800          # 2 天：按天分桶的分桶 key
CG_TTL_INDEX_SECONDS=691200    # 8 天：按天索引集合（用于枚举历史分桶）
CG_TTL_DEDUP_SECONDS=604800    # 7 天：trace_id 幂等去重集合（必须 >= 业务最长重试周期）
CG_TTL_WINDOW_SECONDS=3600     # 1 小时：滑动窗口 ZSET 的兜底 TTL

# ---------- 时段判定 ----------
# 官方高峰时段按北京时间（UTC+8）周一至周五 9:00-12:00、14:00-18:00 判定
CG_TIMEZONE=Asia/Shanghai
CG_PEAK_WINDOWS=09:00-12:00,14:00-18:00
# 中国法定节假日的日期列表（YYYY-MM-DD，逗号分隔）。
# 官方规则里节假日全天按空闲时段计价，但节假日安排逐年公布，本库不内置日历，需人工维护。
CG_HOLIDAYS=

# ---------- 统计 ----------
CG_MIN_SAMPLE_SIZE=30          # MAD 离群检测的最小样本量，低于该值返回“样本不足”
CG_MAD_THRESHOLD=3.5           # modified z-score 阈值
CG_RECONCILE_TOLERANCE=0.01    # 与账单对账时允许的相对差异（1%）

# ---------- 滑动窗口（无效重试识别）----------
# 注意：窗口秒数与次数阈值是两个完全独立的参数，不要混为一谈
CG_RETRY_WINDOW_SECONDS=60
CG_RETRY_MAX_CALLS=8

# ---------- 可观测性 ----------
CG_LOG_LEVEL=INFO
CG_FAIL_ON_STORAGE_ERROR=false # 埋点写入失败时是否向上抛出（默认只记日志，不影响业务）

# ---------- Celery（可选）----------
# 留空则 build_celery_app() 返回 None，导入期不会连接任何 broker
# CG_CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# CG_CELERY_RESULT_BACKEND=
